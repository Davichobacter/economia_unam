\@writefile{toc}{\contentsline {section}{\numberline {A}Evidencias gráficas de la Actividad 4}{6}{appendix.Alph1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Configuración de la conexión a la base de datos PostgreSQL simulada, establecida sobre un entorno local, utilizada para la ejecución de consultas y validaciones sin exponer información sensible.}}{7}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Definición del servicio de base de datos PostgreSQL mediante contenedores Docker, utilizada para hospedar una base de datos ficticia en un entorno local y controlado.}}{8}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Ejecución de una consulta SQL para la recuperación de registros en estatus \textit  {EN\_PROCESO}, ordenados por prioridad y fecha de creación, utilizada para el análisis operativo.}}{8}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Consulta SQL orientada a la identificación de registros sin responsable asignado, como parte del proceso de validación y control de calidad de la información.}}{9}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Consulta utilizada para la validación de valores de estatus no contemplados dentro de los criterios definidos, con el objetivo de detectar inconsistencias en los datos.}}{9}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Identificación de registros con inconsistencias temporales, donde la fecha de cierre es anterior a la fecha de creación, como parte del proceso de validación de integridad de la información.}}{10}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Consulta con unión de tablas utilizada para generar una serie temporal de registros creados por mes y por origen, orientada al análisis de volumen y comportamiento operativo.}}{10}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Consulta SQL con agregaciones y unión de tablas utilizada para calcular el tiempo promedio de cierre por categoría, como indicador de desempeño operativo.}}{11}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Consulta SQL con agregaciones y unión de tablas utilizada para calcular el tiempo promedio de cierre por categoría, permitiendo identificar diferencias en el desempeño operativo entre áreas funcionales.}}{11}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Consulta SQL orientada al conteo de registros por tipo de evento, utilizada para analizar el avance de los registros a través de las distintas etapas del proceso operativo.}}{12}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Consulta avanzada mediante expresiones comunes de tabla (CTE) utilizada para calcular el porcentaje de registros que alcanzan cada tipo de evento, con relación al total de registros creados.}}{12}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Consulta SQL con funciones de ventana utilizada para generar un ranking de responsables con mayor número de registros activos, como apoyo al análisis de distribución de carga operativa.}}{13}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Consulta orientada a la generación de indicadores de calidad de datos por origen, identificando registros incompletos y porcentajes de información faltante como apoyo al control de consistencia.}}{13}{figure.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Ejecución de una actualización controlada de estatus sobre un registro específico, incorporando validaciones previas para asegurar la integridad del proceso.}}{14}{figure.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Proceso de normalización de valores de prioridad mediante sentencias de actualización, con el objetivo de estandarizar la información almacenada en la base de datos.}}{14}{figure.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Actualización de registros utilizando expresiones condicionales para homologar distintos valores de prioridad, garantizando consistencia semántica en la información.}}{15}{figure.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Creación de una vista lógica consolidada a partir de múltiples tablas, diseñada para facilitar el análisis integral de la información y su consumo por herramientas de visualización.}}{15}{figure.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Consulta sobre la vista consolidada utilizada para obtener métricas agregadas por categoría, origen, estatus y prioridad, como apoyo a la generación de reportes operativos.}}{16}{figure.18}\protected@file@percent }
